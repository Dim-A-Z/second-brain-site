---
import 'leaflet/dist/leaflet.css';

interface MapStop {
  order: number;
  title: string;
  address: string;
  latitude: number;
  longitude: number;
  anchor: string;
}

interface BonusMapStop {
  title: string;
  address: string;
  latitude: number;
  longitude: number;
}

const { stops, bonusStops = [] } = Astro.props as { stops: MapStop[]; bonusStops?: BonusMapStop[] };
const mapId = `route-map-${Math.random().toString(36).slice(2)}`;
const coordinate = (stop: MapStop) => `${stop.latitude},${stop.longitude}`;
const yandexUrl = `https://yandex.ru/maps/?rtext=${stops.map(coordinate).join('~')}&rtt=pd`;
const googleParams = new URLSearchParams({
  api: '1',
  origin: coordinate(stops[0]),
  destination: coordinate(stops.at(-1)!),
  waypoints: stops.slice(1, -1).map(coordinate).join('|'),
  travelmode: 'walking',
});
const googleUrl = `https://www.google.com/maps/dir/?${googleParams.toString()}`;
---

<section class="map-panel" aria-labelledby={`${mapId}-title`}>
  <div class="section-heading">
    <div>
      <p class="eyebrow">Маршрут на карте</p>
      <h2 id={`${mapId}-title`}>Девять остановок</h2>
    </div>
    <p class="map-note">Пунктир показывает порядок точек, а не точный пешеходный путь.</p>
  </div>
  <div class="map-actions">
    <a class="map-button" href={yandexUrl} target="_blank" rel="noreferrer">Открыть маршрут в Яндекс Картах ↗</a>
    <a class="map-button map-button-secondary" href={googleUrl} target="_blank" rel="noreferrer">Открыть в Google Maps ↗</a>
  </div>
  <div id={mapId} class="route-map" data-stops={JSON.stringify(stops)} data-bonus-stops={JSON.stringify(bonusStops)} aria-label="Интерактивная карта маршрута"></div>
  <noscript><p class="map-fallback">Карта требует JavaScript. Все адреса и описания доступны ниже.</p></noscript>
</section>

<script>
  import L from 'leaflet';

  document.querySelectorAll<HTMLElement>('.route-map:not([data-ready])').forEach((element) => {
    element.dataset.ready = 'true';
    const stops = JSON.parse(element.dataset.stops ?? '[]');
    const bonusStops = JSON.parse(element.dataset.bonusStops ?? '[]');
    if (!stops.length) return;

    const map = L.map(element, { scrollWheelZoom: false });
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; OpenStreetMap contributors',
      maxZoom: 19,
    }).addTo(map);

    const coordinates: L.LatLngExpression[] = [];
    for (const stop of stops) {
      const icon = L.divIcon({
        className: 'route-marker-shell',
        html: `<span class="route-marker">${stop.order}</span>`,
        iconSize: [34, 34],
        iconAnchor: [17, 17],
      });
      const coordinate: L.LatLngExpression = [stop.latitude, stop.longitude];
      coordinates.push(coordinate);
      L.marker(coordinate, { icon })
        .addTo(map)
        .bindPopup(`<strong>${stop.order}. ${stop.title}</strong><br>${stop.address}<br><a href="#${stop.anchor}">Перейти к остановке ↓</a>`);
    }

    for (const stop of bonusStops) {
      const icon = L.divIcon({
        className: 'bonus-marker-shell',
        html: '<span class="bonus-marker">★</span>',
        iconSize: [32, 32],
        iconAnchor: [16, 16],
      });
      L.marker([stop.latitude, stop.longitude], { icon })
        .addTo(map)
        .bindPopup(`<strong>★ ${stop.title}</strong><br>${stop.address}<br><span>Бонусная остановка</span>`);
    }

    const line = L.polyline(coordinates, { color: '#9b3f2d', weight: 3, opacity: 0.78, dashArray: '8 8' }).addTo(map);
    map.fitBounds(line.getBounds(), { padding: [28, 28] });
  });
</script>
