---
import { getCollection } from 'astro:content';
import ContentCard from '../components/ContentCard.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { site } from '../config/site';
import '../styles/global.css';

const [latestRoute] = await getCollection('routes');
if (!latestRoute) throw new Error('The home page requires at least one published Route.');

const baseUrl = import.meta.env.BASE_URL;
const routeUrl = `${baseUrl}routes/${latestRoute.data.city}/${latestRoute.data.slug}/`;
const travelUrl = `${baseUrl}travel/`;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={site.description} />
    <title>{site.title}</title>
  </head>
  <body>
    <SiteHeader currentPage="home" />
    <main class="landing-page">
      <header class="landing-hero">
        <p class="eyebrow">Личный журнал</p>
        <h1>{site.title}</h1>
        <p class="landing-description">{site.description}</p>
        <div class="social-links" aria-label="Социальные сети">
          {site.socialLinks.map((link, index) => (
            <>
              <a href={link.url} target="_blank" rel="noreferrer">{link.label}</a>
              {index < site.socialLinks.length - 1 && <span aria-hidden="true">·</span>}
            </>
          ))}
        </div>
      </header>

      <section class="content-section" aria-labelledby="latest-title">
        <div class="content-section-heading">
          <div>
            <p class="eyebrow">Последнее</p>
            <h2 id="latest-title">Новые материалы</h2>
          </div>
          <a href={travelUrl}>Все путешествия →</a>
        </div>
        <div class="content-grid">
          <ContentCard
            typeLabel="Маршрут"
            contextLabel="Москва"
            title={latestRoute.data.title}
            description={latestRoute.data.description}
            href={routeUrl}
            actionLabel="Открыть маршрут →"
          />
        </div>
      </section>
    </main>
  </body>
</html>
